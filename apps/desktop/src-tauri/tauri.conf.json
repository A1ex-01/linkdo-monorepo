{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Linkdo",
  "version": "0.1.6",
  "identifier": "com.tauri.linkdo",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Linkdo",
        "width": 1400,
        "height": 850,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "alwaysOnTop": false,
        "shadow": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}