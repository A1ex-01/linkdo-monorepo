# Link-Do Coding Standards

## Project Overview

Link-Do is a macOS desktop task management app using Tauri 2 + React 19 + Next.js App Router + Tailwind CSS + Zustand.

## File Naming

| Type | Convention | Example |
|------|-----------|---------|
| All files | **kebab-case** | `collection-card.tsx`, `client-request.ts` |
| Directories | **kebab-case** | `app/home/_components/` |
| Page files | **kebab-case** | `app/home/page.tsx` |
| Component files | **kebab-case** | `create-collection-modal.tsx` |

**Never use:** CamelCase, PascalCase, or snake_case for file names.

## TypeScript

### Interface Naming

```typescript
// ✅ Use I prefix for interfaces
interface ICollection { ... }
interface ITask { ... }
interface IUser { ... }

// ✅ Use DTO suffix for data transfer objects
interface CreateCollectionDTO { ... }
interface UpdateTaskDTO { ... }
```

### Props Interface Naming

```typescript
// ✅ Props interface named I{ComponentName}Props
interface ICollectionCardProps {
  collection: ICollection;
  onClick: () => void;
}

export default function CollectionCard({ collection, onClick }: ICollectionCardProps) {
  // ...
}
```

### Type Exports with Alias

```typescript
// Re-export with type aliasing
export type {
  ICollection as Collection,
  ITask as Task,
  TaskStatus,
};
```

### Generic Usage

```typescript
// API response with generic
export interface ApiResponse<T> {
  success: boolean;
  data?: T;
  error?: string;
  message?: string;
}
```

## Component Patterns

### Functional Components Only

```typescript
// ✅ Always use functional components
export default function CollectionCard({ ... }: ICollectionCardProps) {
  return <div>...</div>;
}

// ✅ Named export for complex components
export function KanbanBoard({ tasks }: IKanbanBoardProps) {
  return <div>...</div>;
}
```

### Props Destructure in Parameters

```typescript
// ✅ Destructure props directly in function parameters
export default function CollectionCard({
  collection,
  onClick,
}: ICollectionCardProps) {
  // Use collection and onClick directly
}

// ❌ Don't do this
export default function CollectionCard(props: ICollectionCardProps) {
  const { collection, onClick } = props;
}
```

## Import Organization

Follow this import order:

1. `"use client"` directive (if needed)
2. React/framework imports
3. Absolute path `@/` imports (components, services, stores)
4. Third-party library imports (icons, ahooks, next/navigation, etc.)
5. Relative imports (local components from same directory)

```typescript
"use client";

import BottomNav from "@/components/bottom-nav";
import { useUserStore } from "@/stores/user";
import { IconPlus } from "@tabler/icons-react";
import { useRequest } from "ahooks";
import { useRouter } from "next/navigation";
import { useState } from "react";
import CollectionCard from "./_components/collection-card";
```

## State Management (Zustand)

### Store Naming & Structure

```typescript
// File: stores/user.ts
// Store named use{StoreName}Store

import { create } from "zustand";
import { TOKEN_KEY } from "@/config";
import { ApiResponse, getMe, MeResponse } from "@/services/base";
import { IUser } from "@/types/base";

interface IST {
  isFetchedUser: boolean;
  user: IUser | undefined;
  fetchUser: () => Promise<ApiResponse<MeResponse>>;
}

export const useUserStore = create<IST>((set) => ({
  isFetchedUser: false,
  user: undefined,
  fetchUser: async () => {
    const token = localStorage.getItem(TOKEN_KEY);
    if (!token) {
      set({ isFetchedUser: true });
    }
    const response = await getMe();
    if (response.success) {
      set({ user: response.data, isFetchedUser: true });
    } else {
      set({ isFetchedUser: true });
    }
    return response;
  },
}));
```

### Store Usage

```typescript
const { user, fetchUser } = useUserStore();
```

## API Calls (ahooks useRequest)

### GET Requests - Auto-fetch

```typescript
const {
  loading,
  refresh,
  data: collections = [],
} = useRequest(
  async () => {
    const res = await getCollections();
    return res.data;
  },
  {
    manual: false,  // Auto-fetch on mount
  },
);
```

### POST/PUT/DELETE - Manual Trigger

```typescript
const { runAsync: submitCreate } = useRequest(
  async (data: { name: string; icon: string }) => {
    const res = await createCollection(data);
    return res;
  },
  { manual: true },
);

// Call directly without onSuccess
await submitCreate(data);
refresh();
```

### With refreshDeps

```typescript
const { data: tasks, runAsync: getTasks } = useRequest(
  async () => {
    const tasksRes = await getTasksService(collectionUuid!);
    if (tasksRes.success && tasksRes.data) {
      return tasksRes.data;
    } else {
      toast.error(tasksRes.message ?? "Failed to fetch tasks");
      return [];
    }
  },
  {
    refreshDeps: [collectionUuid],  // Re-fetch when dependency changes
  },
);
```

### Error Handling Pattern

```typescript
const handleSubmitCreate = async (data: { name: string; icon: string }) => {
  try {
    toast.loading("Creating collection...");
    const res = await submitCreate(data);
    if (res.success) {
      refresh();
      toast.success("Collection created successfully");
    }
  } catch (err) {
    console.error("Failed to create collection:", err);
    toast.error("Failed to create collection");
  }
};
```

