# Copy this file to deploy/.env on the Linux host. Do not commit deploy/.env.
COMPOSE_PROJECT_NAME=linkdo
HTTP_PORT=80

# Tencent Cloud Container Registry. Images are built locally and pushed here;
# the Linux host only pulls the selected tag.
REGISTRY_HOST=ccr.ccs.tencentyun.com
CCR_NAMESPACE=ax-linkdo
IMAGE_TAG=latest

# Required infrastructure credentials. Generate values, for example:
# openssl rand -hex 32
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=linkdo
REDIS_PASSWORD=change-me
RABBITMQ_USER=linkdo
RABBITMQ_PASSWORD=change-me

# MySQL, Redis, and AMQP URLs are derived from the credentials above by Compose.
JWT_SECRET=change-me-to-a-long-random-string
BASE_SERVICE_URL=http://base-service:8081
LINK_SERVICE_URL=http://link-service:8082
FILE_SERVICE_URL=http://file-service:8083
DEBUG=false
APP_TIME_ZONE=Asia/Shanghai

# OAuth and mail provider settings. Leave unused integrations empty.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=https://app.example.com/api/link/notion/callback
NOTION_TOKEN_ENCRYPTION_KEY=
LINK_OAUTH_STATE_SECRET=
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
CLICKUP_REDIRECT_URI=https://app.example.com/api/link/clickup/callback
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_DIRECT_MAIL_ACCOUNT_NAME=
ALIYUN_DIRECT_MAIL_FROM_ALIAS=Link-Do
ALIYUN_DIRECT_MAIL_REPLY_TO=false
ADMIN_EMAILS=

# file-service requires all four OSS values at startup.
OSS_REGION=
OSS_BUCKET=

# Build-time variables for the admin SPA. Never put private secrets here.
VITE_CLERK_PUBLISHABLE_KEY=
# Reserved for the future Python agent; it is not deployed by compose.yaml yet.
VITE_PUBLIC_AGENT_URL=
VITE_PUBLIC_AGENT_API_KEY=
