FROM node:22-alpine AS builder

WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/admin/package.json apps/admin/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN pnpm install --frozen-lockfile --filter @linkdo/admin...

COPY --exclude=.env --exclude=.env.* --exclude=node_modules apps/admin apps/admin
COPY apps/desktop/src/styles/themes apps/desktop/src/styles/themes
COPY packages/shared packages/shared
COPY packages/ui packages/ui

ARG VITE_CLERK_PUBLISHABLE_KEY
ARG VITE_PUBLIC_AGENT_URL
ENV VITE_CLERK_PUBLISHABLE_KEY=$VITE_CLERK_PUBLISHABLE_KEY \
    VITE_PUBLIC_AGENT_URL=$VITE_PUBLIC_AGENT_URL
RUN pnpm --filter @linkdo/admin exec vite build --mode product

FROM nginx:1.27-alpine
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/admin/dist /usr/share/nginx/html
EXPOSE 80
