FROM node:22-alpine AS builder

WORKDIR /app
RUN corepack enable
COPY apps/admin/package.json apps/admin/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY --exclude=.env --exclude=.env.* --exclude=node_modules apps/admin/ ./

ARG VITE_CLERK_PUBLISHABLE_KEY
ARG VITE_PUBLIC_AGENT_URL
ARG VITE_PUBLIC_AGENT_API_KEY
ENV VITE_CLERK_PUBLISHABLE_KEY=$VITE_CLERK_PUBLISHABLE_KEY \
    VITE_PUBLIC_AGENT_URL=$VITE_PUBLIC_AGENT_URL \
    VITE_PUBLIC_AGENT_API_KEY=$VITE_PUBLIC_AGENT_API_KEY
# Build the static artifact. The repository's `pnpm build` also runs TypeScript
# type-checking; keep that as a separate CI quality gate rather than making the
# image build depend on unrelated existing type errors.
RUN pnpm exec vite build

FROM nginx:1.27-alpine
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
