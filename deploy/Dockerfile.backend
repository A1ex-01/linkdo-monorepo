FROM golang:1.26-alpine AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY --exclude=.env --exclude=.env.development --exclude=.env.product --exclude=.env.production --exclude=.env.server . .

RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/app-gateway ./gateway/cmd/main.go \
 && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/app-base ./base_service/cmd/main.go \
 && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/app-link ./link_service/cmd/main.go \
 && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/app-file ./file_service/cmd/main.go \
 && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/app-worker ./base_service/cmd/worker-email/main.go

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=builder /out/ ./
CMD ["./app-gateway"]
