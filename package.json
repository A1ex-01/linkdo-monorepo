{
  "name": "linkdo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "dev:desktop": "pnpm --filter @linkdo/desktop dev",
    "dev:admin": "pnpm --filter @linkdo/admin dev",
    "dev:web": "pnpm --filter @linkdo/web dev",
    "build:desktop": "pnpm --filter @linkdo/desktop build",
    "build:admin": "pnpm --filter @linkdo/admin build"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "turbo": "^2.10.12"
  }
}
