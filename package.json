{
  "name": "link-do",
  "private": true,
  "scripts": {
    "dev:frontend": "pnpm --filter @link-do/frontend dev",
    "dev:admin": "pnpm --filter @link-do/admin dev",
    "dev:mcp": "pnpm --filter @link-do/mcp dev",
    "build:frontend": "pnpm --filter @link-do/frontend build",
    "build:admin": "pnpm --filter @link-do/admin build",
    "build:mcp": "pnpm --filter @link-do/mcp build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.1.5",
      "@types/react-dom": "19.1.5",
      "@ant-design/icons": "5.6.1",
      "@ant-design/pro-components": "2.8.10",
      "@link-do/admin>eslint": "8.57.1"
    }
  }
}