  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT or user token"
      }
    },
    "schemas": {
      "Collection": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "description": "External UUID for API exposure (format: cl_xxxxxxxx)",
            "example": "cl_a1b2c3d4e5f6"
          },
          "name": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "notion_uuid": {
            "type": "string",
            "nullable": true
          },
          "pending_count": {
            "type": "integer"
          },
          "estimated_total": {
            "type": "integer"
          },
          "is_archived": {
            "type": "boolean"
          },
          "notion_databases": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NotionDatabase"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "NotionDatabase": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "description": "External UUID for API exposure (format: nd_xxxxxxxx)",
            "example": "nd_a1b2c3d4e5f6"
          },
          "collection_uuid": {
            "type": "string",
            "description": "Parent collection UUID"
          },
          "notion_database_id": {
            "type": "string",
            "description": "Notion's internal database ID"
          },
          "name": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "status_mapping": {
            "type": "object",
            "description": "Maps app status (backlog/this_week/today/done) to array of Notion status values",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "notion_options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Cached available Notion status options"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "description": "External UUID for API exposure (format: tk_xxxxxxxx)",
            "example": "tk_a1b2c3d4e5f6"
          },
          "collection_uuid": {
            "type": "string",
            "description": "Parent collection UUID"
          },
          "notion_database_uuid": {
            "type": "string",
            "nullable": true,
            "description": "Associated Notion database UUID"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "backlog",
              "this_week",
              "today",
              "done"
            ]
          },
          "notion_page_id": {
            "type": "string",
            "nullable": true
          },
          "notion_uuid": {
            "type": "string",
            "nullable": true
          },
          "estimated_time": {
            "type": "integer",
            "description": "Minutes"
          },
          "actual_time": {
            "type": "integer",
            "description": "Minutes (cumulative)"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TimeSession": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "description": "External UUID for API exposure (format: ts_xxxxxxxx)",
            "example": "ts_a1b2c3d4e5f6"
          },
          "task_uuid": {
            "type": "string",
            "description": "Associated task UUID"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "ended_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "duration": {
            "type": "integer",
            "description": "Seconds"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "description": "External UUID for API exposure (format: us_xxxxxxxx)",
            "example": "us_a1b2c3d4e5f6"
          },
          "notion_user_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "avatar_url": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}