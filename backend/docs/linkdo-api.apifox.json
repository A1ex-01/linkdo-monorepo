    "/api/v1/notion-databases/{uuid}/status-mapping": {
      "get": {
        "summary": "Get status mapping for a Notion database",
        "tags": [
          "Notion Databases"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "uuid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "NotionDatabase UUID"
          }
        ],
        "responses": {
          "200": {
            "description": "Status mapping with available Notion options",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "notion_options": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "Available Notion status values fetched from the DB"
                        },
                        "mapping": {
                          "type": "object",
                          "description": "Maps app status (backlog/this_week/today/done) to Notion status values",
                          "additionalProperties": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update status mapping for a Notion database",
        "tags": [
          "Notion Databases"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "uuid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "NotionDatabase UUID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mapping": {
                    "type": "object",
                    "description": "Maps app status to array of Notion status values",
                    "example": {
                      "backlog": [
                        "未开始",
                        "进行中"
                      ],
                      "today": [
                        "进行中"
                      ],
                      "done": [
                        "完成"
                      ]
                    },
                    "additionalProperties": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Invalid request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/v1/notion-databases/{uuid}/status-mapping/fetch": {
      "post": {
        "summary": "Fetch available status options from Notion DB (just fetches, does not save mapping)",
        "tags": [
