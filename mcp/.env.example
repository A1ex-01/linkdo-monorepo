# Link-Do MCP Server Configuration
# Copy this file to .env and fill in the values

# Required: Link-Do backend URL (must include OAuth endpoints)
LINKDO_API_BASE_URL=http://localhost:8080

# Optional: MCP server bind host (default: 127.0.0.1)
MCP_HOST=127.0.0.1

# Optional: MCP server port (default: 3001)
MCP_PORT=3456
