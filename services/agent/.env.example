AGENT_API_KEY=your-secret-api-key-here

# LLM
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=120

# MCP Server (HTTP 远程服务)
MCP_BASE_URL=http://127.0.0.1:3456
MCP_TOKEN=
MCP_TIMEOUT=30

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=6001
SERVER_LOG_LEVEL=info


# LangSmith
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=link-do-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
