{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: Base Service (:8081)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/services/backend/base_service/cmd",
      "cwd": "${workspaceFolder}/services/backend",
      "env": {
        "DEBUG": "true",
        "BASE_PORT": "8081",
        "HTTP_PROXY": "http://127.0.0.1:7890",
        "HTTPS_PROXY": "http://127.0.0.1:7890",
        "NO_PROXY": "localhost,127.0.0.1"
      }
    },
    {
      "name": "Debug: Link Service (:8082)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/services/backend/link_service/cmd",
      "cwd": "${workspaceFolder}/services/backend",
      "env": {
        "DEBUG": "true",
        "LINK_PORT": "8082",
        "HTTP_PROXY": "http://127.0.0.1:7890",
        "HTTPS_PROXY": "http://127.0.0.1:7890",
        "NO_PROXY": "localhost,127.0.0.1"
      }
    },
    {
      "name": "Debug: Gateway (:8080)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/services/backend/gateway/cmd",
      "cwd": "${workspaceFolder}/services/backend",
      "env": {
        "DEBUG": "true",
        "GATEWAY_PORT": "8080",
        "BASE_SERVICE_URL": "http://localhost:8081",
        "LINK_SERVICE_URL": "http://localhost:8082",
        "FILE_SERVICE_URL": "http://localhost:8083"
      }
    },
    {
      "name": "Debug: File Service (:8083)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/services/backend/file_service/cmd",
      "cwd": "${workspaceFolder}/services/backend",
      "env": {
        "DEBUG": "true",
        "FILE_PORT": "8083",
        "HTTP_PROXY": "http://127.0.0.1:7890",
        "HTTPS_PROXY": "http://127.0.0.1:7890",
        "NO_PROXY": "localhost,127.0.0.1"
      }
    },
    {
      "name": "Debug: Email Worker",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/services/backend/base_service/cmd/worker-email",
      "cwd": "${workspaceFolder}/services/backend",
      "env": {
        "DEBUG": "true",
        "HTTP_PROXY": "http://127.0.0.1:7890",
        "HTTPS_PROXY": "http://127.0.0.1:7890",
        "NO_PROXY": "localhost,127.0.0.1"
      }
    }
  ],
  "compounds": [
    {
      "name": "Debug: All Backend Services",
      "configurations": [
        "Debug: Base Service (:8081)",
        "Debug: Link Service (:8082)",
        "Debug: File Service (:8083)",
        "Debug: Email Worker",
        "Debug: Gateway (:8080)"
      ],
      "stopAll": true
    }
  ]
}